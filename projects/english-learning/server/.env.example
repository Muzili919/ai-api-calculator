# 复制为 .env.local 并填入真实 key(.env.local 已被 gitignore,绝不提交)
DEEPSEEK_API_KEY=sk-你的key
# 可选
DEEPSEEK_MODEL=deepseek-v4-flash
PORT=3210

# 讯飞开放平台 语音评测 ISE(三件套,缺一不可)
# 控制台 → 我的应用 → 应用详情页可见;详见 ../05-api-onboarding.md
XF_APPID=
XF_API_KEY=
XF_API_SECRET=

# 火山引擎(豆包)TTS —— 示范音首选(全境内)
# 控制台 → 语音技术 → 应用管理 拿 APPID 与 Access Token;音色列表页挑英式英文音色
VOLC_APPID=
VOLC_ACCESS_TOKEN=
VOLC_VOICE=
# VOLC_CLUSTER=volcano_tts
